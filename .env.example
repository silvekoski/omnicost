# Cost City backend — copy to `.env` and fill in. The server reads this on startup.
# Anything left blank degrades gracefully (template draft / dry-run send).

# --- Resend (email sending) ---------------------------------------------------
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Every email is delivered here, regardless of the customer's display address.
MAIL_TO=silveikka@gmail.com

# Sender. Resend's shared `onboarding@resend.dev` only delivers to the address that
# owns the Resend account — fine here since MAIL_TO is your own inbox. To send from
# your own domain, verify it in Resend and put e.g. "Cost City <hello@yourdomain.com>".
MAIL_FROM=Aiven Cost City <onboarding@resend.dev>

# --- Featherless (AI email drafting, OpenAI-compatible) -----------------------
# Get a key at https://featherless.ai/  (Authorization: Bearer <key>)
FEATHERLESS_API_KEY=

# Any model id from the Featherless catalog (HF repo id). Override if this one
# isn't on your plan — e.g. mistralai/Mistral-Nemo-Instruct-2407,
# Qwen/Qwen2.5-7B-Instruct, meta-llama/Meta-Llama-3.1-70B-Instruct.
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
