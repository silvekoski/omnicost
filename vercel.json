{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(config|draft|send)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
